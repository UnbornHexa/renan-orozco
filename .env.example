# MongoDB Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=weather_db
MONGO_PORT=27017

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672

# API NestJS Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please-use-a-strong-random-key
API_PORT=3000
NODE_ENV=development
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=123456
COUNTRY_STATE_CITY_API_KEY=QVVQOFg0T3NheE5zVjZ4angzcUkzYkNWcVB5VFhLSkRoZWs5WEJsWA==
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Weather Collector Configuration
# API_URL is used as base URL (e.g., http://api:3000/api)
# The service appends /users/with-locations to this URL
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
API_URL=http://api:3000/api
COLLECTION_INTERVAL=60

# Go Worker Configuration
# GO_WORKER_API_URL must be the complete endpoint URL for POST requests
GO_WORKER_API_URL=http://api:3000/api/weather/logs
QUEUE_NAME=weather_data

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000/api
